# Linear webhook signing secret (from Linear settings > API > Webhooks)
# If unset, signature verification is skipped (useful for development)
# Supports multiple comma-separated secrets for multiple webhooks
LINEAR_WEBHOOK_SECRET=
# LINEAR_WEBHOOK_SECRETS=secret1,secret2

# Comma-separated list of resource types to surface as events
# Default: Issue,Comment,AgentSessionEvent,AppUserNotification
# Available: Issue, Comment, Project, Cycle, Label, IssueLabel, Reaction, etc.
LINEAR_RESOURCE_TYPES=Issue,Comment

# Ngrok tunnel auto-repair (optional)
# When set, the plugin auto-creates/updates the ngrok tunnel on sidecar restart
LINEAR_NGROK_SUBDOMAIN=
# Tunnel name in ngrok (default: "linear")
# LINEAR_NGROK_TUNNEL=linear
