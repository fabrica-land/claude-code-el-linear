# Linear webhook signing secret (from Linear settings > API > Webhooks)
# If unset, signature verification is skipped (useful for development)
LINEAR_WEBHOOK_SECRET=

# Comma-separated list of resource types to surface as events
# Default: Issue,Comment
# Available: Issue, Comment, Project, Cycle, Label, IssueLabel, Reaction, etc.
LINEAR_RESOURCE_TYPES=Issue,Comment
